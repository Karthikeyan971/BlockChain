    {
      "name": "Blockchain Inspection",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:3000/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": [""]
            },
            "description": "Server health + chain stats (length, valid, latestHash)"
          }
        },
        {
          "name": "View Full Blockchain",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:3000/chain",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["chain"]
            },
            "description": "Returns every block in the chain — run this after all 10 predictions to see 11 blocks (genesis + 10 events)"
          }
        },
        {
          "name": "Validate Chain Integrity",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:3000/chain/validate",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["chain", "validate"]
            },
            "description": "Returns valid:true if untampered. Manually edit chain.json and re-send — it returns valid:false (tamper detection demo)"
          }
        },
        {
          "name": "Latest Block",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:3000/chain/latest",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["chain", "latest"]
            },
            "description": "Returns only the most recently added block"
          }
        }
